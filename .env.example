# OpenRouter API key.
# Optional: visitors normally add their own free key in Settings. The server key
# is only lent to keyless visitors on Vercel Previews or with OPENCONVO_HOSTED_FREE=on.
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Lend the server keys to visitors without their own (on | off). Default: off,
# except on Vercel Previews. On Vercel production, "on" also requires the
# shared quota store below.
OPENCONVO_HOSTED_FREE=

# Shared quota store for hosted mode (Upstash Redis REST; Vercel KV's
# KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hosted chat limits: per visitor, and for all keyless visitors together.
OPENCONVO_HOSTED_FREE_DAILY_LIMIT=20
OPENCONVO_HOSTED_FREE_GLOBAL_DAILY_LIMIT=30

# Tavily Search API key.
# Optional extra search source. Search works without it (keyless Bing, DuckDuckGo,
# Bing News, Google News and Wikipedia).
# Get yours at https://tavily.com
TAVILY_API_KEY=

# Optional self-hosted metasearch endpoint, for example https://search.example.com
# When set, it is queried alongside the keyless sources.
SEARXNG_URL=

# Hosted search limits: per visitor, and for all visitors together.
OPENCONVO_HOSTED_SEARCH_DAILY_LIMIT=15
OPENCONVO_HOSTED_SEARCH_GLOBAL_DAILY_LIMIT=20

# Set to off to stop querying the Bing News and Google News RSS feeds.
# OPENCONVO_NEWS_FEEDS=on

# Set to false to stop the model reading full result pages.
# OPENCONVO_ENABLE_PAGE_EXTRACTION=true

# Public GitHub repo URL shown on the landing page after you publish the project.
NEXT_PUBLIC_GITHUB_URL=https://github.com/fayzkk889/openconvo

# Public site URL used for Open Graph images and social previews.
NEXT_PUBLIC_SITE_URL=https://openconvo.vercel.app
